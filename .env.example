# Public application origin. Google must allow exactly APP_URL/auth/google/callback.
APP_URL=http://localhost:3000

# Server-side authentication values. AUTH_SECRET must be 32+ random characters.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI engine provider secret; keep server-side only
OPENAI_API_KEY=

# Replace generic names with the selected payment provider's variables
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=

# Transactional email provider
EMAIL_API_KEY=
EMAIL_FROM=

# Use when migrating from Cloudflare D1 to an external SQL database
DATABASE_URL=
